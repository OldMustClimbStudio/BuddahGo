# Unity YAML / text assets stay in normal Git.
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.playable text eol=lf
*.vfx text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf

# Binary assets use Git LFS.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
