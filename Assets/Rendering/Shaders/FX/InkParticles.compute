// InkParticles: GPU ink-smoke particles for the 如来神掌 hand (Docs/vfx/palm-mesh-tripo.md section 18).
// Particles are born on the hand's mesh surface (area-weighted triangle sampling, so every part of the hand smokes
// in proportion to its skin), then live in world space: a divergence-free curl-noise flow (fixed in the world, slowly
// evolving) pulls them into sheets and filaments, the hand's SDF keeps them outside the solid, damping settles them.
// Nothing rises; nothing follows the hand except what inheritVelocity hands over at birth. The ring buffer is
// overwritten oldest-first (Emit), so the capacity / rate pair sets the longest life that is actually reachable.
#pragma kernel Emit
#pragma kernel Update
#pragma kernel Clear

struct Particle
{
    float3 pos;     // world
    float age;      // seconds since birth; >= life means dead
    float3 vel;     // world units / s
    float life;     // total lifetime (s)
    float seed;     // 0..1 per particle
    float3 pad;
};

struct Tri
{
    float3 a;
    float3 b;
    float3 c;
    float3 n;       // hand-space normal
    float cum;      // cumulative area, normalised to 0..1 at the last triangle
    float3 pad;
};

RWStructuredBuffer<Particle> _Particles;
StructuredBuffer<Tri> _Tris;
Texture3D<float> _Sdf;
SamplerState sampler_linear_clamp;

uint _Capacity;
uint _TriCount;
uint _EmitStart;
uint _EmitCount;
uint _Frame;
float _Dt;
float _Time;
float4x4 _HandToWorld;
float4x4 _WorldToHand;
float3 _HandVelocity;       // world units / s
float _InheritVelocity;
float _StartSpeed;
float _RandomDirection;
float _LifeMin;
float _LifeMax;
float _NoiseStrength;       // acceleration (units / s^2) along the curl field
float _NoiseFrequency;      // 1 / units
float _NoiseScroll;         // field evolution speed
int _NoiseOctaves;
float _Damping;             // 1 / s
float _MaxSpeed;
float _PushBand;            // hand units: particles closer than this to the surface get pushed outward
float _PushStrength;        // units / s^2 at the surface
float3 _VolumeOrigin;
float3 _VolumeSize;
float _SdfRange;

// ---------- hashing / noise ----------
uint WangHash(uint s) { s = (s ^ 61u) ^ (s >> 16); s *= 9u; s ^= s >> 4; s *= 0x27d4eb2du; s ^= s >> 15; return s; }
float Rand(inout uint state) { state = WangHash(state); return (state & 0x00ffffffu) / 16777216.0; }

float Hash3(float3 p)
{
    p = frac(p * 0.3183099 + float3(0.1, 0.3, 0.7));
    p += dot(p, p.yzx + 19.19);
    return frac((p.x + p.y) * p.z);
}

// smooth value noise, 0..1
float VNoise(float3 p)
{
    float3 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = Hash3(i), n100 = Hash3(i + float3(1, 0, 0)), n010 = Hash3(i + float3(0, 1, 0)), n110 = Hash3(i + float3(1, 1, 0));
    float n001 = Hash3(i + float3(0, 0, 1)), n101 = Hash3(i + float3(1, 0, 1)), n011 = Hash3(i + float3(0, 1, 1)), n111 = Hash3(i + float3(1, 1, 1));
    float nx00 = lerp(n000, n100, f.x), nx10 = lerp(n010, n110, f.x), nx01 = lerp(n001, n101, f.x), nx11 = lerp(n011, n111, f.x);
    return lerp(lerp(nx00, nx10, f.y), lerp(nx01, nx11, f.y), f.z);
}

float Fbm(float3 p)
{
    float v = 0.0, a = 0.5, s = 0.0;
    [loop] for (int o = 0; o < max(_NoiseOctaves, 1); o++) { v += a * VNoise(p); s += a; p = p * 2.03 + 11.7; a *= 0.5; }
    return v / s - 0.5;
}

// potential field: three decorrelated fbm channels, scrolled in time so the flow evolves where it stands
float3 Potential(float3 p)
{
    float3 q = p * _NoiseFrequency + float3(0.0, 0.0, _Time * _NoiseScroll);
    return float3(Fbm(q), Fbm(q + float3(31.4, 17.9, 5.3)), Fbm(q + float3(-12.7, 44.1, 23.5)));
}

// curl of the potential: divergence-free, so particles gather into sheets and filaments instead of clumping
float3 Curl(float3 p)
{
    const float e = 0.35;
    float3 dx = (Potential(p + float3(e, 0, 0)) - Potential(p - float3(e, 0, 0))) / (2.0 * e);
    float3 dy = (Potential(p + float3(0, e, 0)) - Potential(p - float3(0, e, 0))) / (2.0 * e);
    float3 dz = (Potential(p + float3(0, 0, e)) - Potential(p - float3(0, 0, e))) / (2.0 * e);
    return float3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x);
}

float SampleSdf(float3 p)
{
    float3 uv = (p - _VolumeOrigin) / _VolumeSize;
    if (any(uv < 0.0) || any(uv > 1.0)) return _SdfRange;
    return (_Sdf.SampleLevel(sampler_linear_clamp, uv, 0) - 0.5) * _SdfRange;
}

// ---------- kernels ----------
[numthreads(64, 1, 1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Capacity) return;
    Particle p = (Particle)0;
    p.age = 1e9; p.life = 1.0;
    _Particles[id.x] = p;
}

[numthreads(64, 1, 1)]
void Emit(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _EmitCount || _TriCount == 0) return;
    uint idx = (_EmitStart + id.x) % _Capacity;
    uint state = WangHash(idx * 7919u + _Frame * 104729u + 1u);
    float r = Rand(state);

    // area-weighted triangle: binary search the cumulative area
    uint lo = 0, hi = _TriCount - 1;
    [loop] while (lo < hi) { uint mid = (lo + hi) >> 1; if (_Tris[mid].cum < r) lo = mid + 1; else hi = mid; }
    Tri t = _Tris[lo];
    float u = Rand(state), v = Rand(state);
    float su = sqrt(u);
    float3 local = t.a * (1.0 - su) + t.b * (su * (1.0 - v)) + t.c * (su * v);
    float3 nLocal = t.n;

    float3 world = mul(_HandToWorld, float4(local, 1.0)).xyz;
    float3 n = normalize(mul((float3x3)_HandToWorld, nLocal));
    float3 rnd = normalize(float3(Rand(state), Rand(state), Rand(state)) * 2.0 - 1.0);
    float3 dir = normalize(lerp(n, rnd, _RandomDirection));
    float speed = _StartSpeed * (0.4 + 0.6 * Rand(state));

    Particle p;
    p.pos = world + n * 0.5;
    p.age = 0.0;
    p.vel = dir * speed + _HandVelocity * _InheritVelocity;
    p.life = lerp(_LifeMin, _LifeMax, Rand(state));
    p.seed = Rand(state);
    p.pad = 0.0;
    _Particles[idx] = p;
}

[numthreads(64, 1, 1)]
void Update(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Capacity) return;
    Particle p = _Particles[id.x];
    if (p.age >= p.life) return;
    p.age += _Dt;

    // flow
    p.vel += Curl(p.pos) * _NoiseStrength * _Dt;

    // stay outside the hand: push along the SDF gradient inside the band
    float3 local = mul(_WorldToHand, float4(p.pos, 1.0)).xyz;
    float sd = SampleSdf(local);
    if (sd < _PushBand)
    {
        const float e = 1.0;
        float3 g = float3(SampleSdf(local + float3(e, 0, 0)) - SampleSdf(local - float3(e, 0, 0)),
                          SampleSdf(local + float3(0, e, 0)) - SampleSdf(local - float3(0, e, 0)),
                          SampleSdf(local + float3(0, 0, e)) - SampleSdf(local - float3(0, 0, e)));
        float3 gw = normalize(mul((float3x3)_HandToWorld, g) + 1e-5);
        float w = saturate(1.0 - sd / max(_PushBand, 1e-3));
        p.vel += gw * _PushStrength * w * _Dt;
        if (sd < 0.0) p.pos += gw * (-sd);     // inside the solid: step straight out
    }

    // air resistance and a speed cap
    p.vel *= max(1.0 - _Damping * _Dt, 0.0);
    float sp = length(p.vel);
    if (sp > _MaxSpeed) p.vel *= _MaxSpeed / sp;

    p.pos += p.vel * _Dt;
    _Particles[id.x] = p;
}
