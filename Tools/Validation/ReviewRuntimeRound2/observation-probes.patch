diff --git a/Assets/Scripts/New_Buddah/Core/BuddahPredictedMotor.ReviewTrace.cs b/Assets/Scripts/New_Buddah/Core/BuddahPredictedMotor.ReviewTrace.cs
new file mode 100644
index 0000000..692d6aa
--- /dev/null
+++ b/Assets/Scripts/New_Buddah/Core/BuddahPredictedMotor.ReviewTrace.cs
@@ -0,0 +1,55 @@
+#if UNITY_EDITOR || DEVELOPMENT_BUILD
+using System;
+using UnityEngine;
+namespace NewBuddah.PredictionV2.Core
+{
+    // Opt-in observer only; no state writes, RPCs or serialized fields.
+    public static class BuddahReviewTrace
+    {
+        public static Action<object> Sink;
+    }
+    public partial class BuddahPredictedMotor
+    {
+        private uint _reviewInputTick;
+        private string _reviewReplicateState;
+        private ulong _reviewReconcilePass;
+        private ulong _reviewConsumptionSequence;
+        private static float[] ReviewVec(Vector3 v) => new[] {v.x,v.y,v.z};
+        private void ReviewRecord(string kind, uint snapshotTick = 0, float correction = 0,
+            BuddahPredictedLaunchHandoffState raw = default, BuddahPredictedModifierState rawModifier = default,
+            uint eventId = 0, uint eventTick = 0, uint logicalId = 0)
+        {
+            if (BuddahReviewTrace.Sink == null) return;
+            if (kind == "reconcile") _reviewReconcilePass++;
+            if (kind == "impulse") _reviewConsumptionSequence++;
+            BuddahReviewTrace.Sink(new {
+                kind, time=Time.realtimeSinceStartupAsDouble, owner=OwnerId, obj=ObjectId,
+                server=IsServerInitialized, localOwner=IsOwner,
+                localTick=TimeManager.LocalTick, serverTick=TimeManager.Tick,
+                inputTick=_reviewInputTick, replicateState=_reviewReplicateState,
+                snapshotTick, correction, eventId, eventTick, logicalId,
+                reconcilePass=_reviewReconcilePass,consumptionSequence=_reviewConsumptionSequence,
+                clientStateTick=PredictionManager.ClientStateTick,serverStateTick=PredictionManager.ServerStateTick,
+                clientReplayTick=PredictionManager.ClientReplayTick,serverReplayTick=PredictionManager.ServerReplayTick,
+                phase=_handoffState.CurrentState.ToString(), active=_handoffState.IsActive,
+                handoffId=_handoffState.EventId, start=_handoffState.StartTick,
+                inheritEnd=_handoffState.InheritEndTick, blendEnd=_handoffState.BlendEndTick,
+                alpha=_handoffState.BlendAlpha, steeringUntil=_handoffState.SuppressSteeringUntilTick,
+                bypassUntil=_handoffState.RoomBypassUntilTick,
+                rawId=raw.EventId, rawStart=raw.StartTick, rawInheritEnd=raw.InheritEndTick,
+                rawBlendEnd=raw.BlendEndTick, rawPhase=raw.CurrentState.ToString(),
+                modifiers=new[]{_modifierState.RootUntilTick,_modifierState.AccelUntilTick,
+                    _modifierState.PostRootAccelUntilTick,_modifierState.ScaleUntilTick,
+                    _modifierState.InvertTurnUntilTick,_modifierState.PushGraceUntilTick,
+                    _modifierState.SuppressSteeringUntilTick,_modifierState.RoomBypassUntilTick},
+                rawModifiers=new[]{rawModifier.RootUntilTick,rawModifier.AccelUntilTick,
+                    rawModifier.PostRootAccelUntilTick,rawModifier.ScaleUntilTick,
+                    rawModifier.InvertTurnUntilTick,rawModifier.PushGraceUntilTick,
+                    rawModifier.SuppressSteeringUntilTick,rawModifier.RoomBypassUntilTick},
+                impulseConsumed=_impulseConsumedThisTick,
+                position=ReviewVec(rb.position),velocity=ReviewVec(rb.velocity)
+            });
+        }
+    }
+}
+#endif
